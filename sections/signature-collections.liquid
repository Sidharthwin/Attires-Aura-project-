{%- liquid
  assign collections_eyebrow = section.settings.eyebrow | default: 'Collections'
  assign collections_heading = section.settings.heading | default: 'Signature Worlds'
  assign collections_text = section.settings.text | default: 'An editorial edit of bridal, festive, and modern occasion wear designed for ceremony and afterglow alike.'
-%}

{%- style -%}
  .signature-collections--{{ section.id }} {
    padding: clamp(7rem, 9vw, 10rem) 0;
    background: linear-gradient(180deg, rgba(255, 250, 244, 0.62) 0%, rgba(241, 232, 219, 0.6) 100%);
  }

  .signature-collections--{{ section.id }} .signature-collections__shell {
    display: grid;
    gap: clamp(3rem, 5vw, 4.6rem);
  }

  .signature-collections--{{ section.id }} .signature-collections__intro {
    max-width: 64rem;
  }

  .signature-collections--{{ section.id }} .signature-collections__eyebrow {
    margin: 0 0 1rem;
    color: var(--luxury-gold-dark);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .signature-collections--{{ section.id }} h2 {
    margin: 0;
    color: var(--luxury-ink);
    font-size: clamp(3.8rem, 5vw, 6.2rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .signature-collections--{{ section.id }} .signature-collections__intro-copy {
    max-width: 58rem;
    margin: 1.6rem 0 0;
    color: var(--luxury-ink-soft);
    font-size: 1.14rem;
    line-height: 1.9;
  }

  .signature-collections--{{ section.id }} .signature-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem;
  }

  .signature-collections--{{ section.id }} .signature-collections__card {
    position: relative;
    overflow: hidden;
    min-height: 70rem;
    background: #120f0d;
    box-shadow: var(--luxury-shadow);
  }

  .signature-collections--{{ section.id }} .signature-collections__card:nth-child(even) {
    transform: translateY(4rem);
  }

  .signature-collections--{{ section.id }} .signature-collections__card a {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    color: #f8efe1;
    text-decoration: none;
  }

  .signature-collections--{{ section.id }} .signature-collections__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .signature-collections--{{ section.id }} .signature-collections__card:hover img {
    transform: scale(1.05);
  }

  .signature-collections--{{ section.id }} .signature-collections__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(18, 15, 13, 0.08) 0%, rgba(18, 15, 13, 0.72) 76%, rgba(18, 15, 13, 0.88) 100%),
      linear-gradient(90deg, rgba(18, 15, 13, 0.12) 0%, rgba(18, 15, 13, 0.02) 100%);
  }

  .signature-collections--{{ section.id }} .signature-collections__content {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    left: 2rem;
    z-index: 2;
  }

  .signature-collections--{{ section.id }} .signature-collections__count {
    display: inline-block;
    margin-bottom: 1rem;
    color: rgba(248, 239, 225, 0.54);
    font-family: var(--font-luxury-heading);
    font-size: 2rem;
    line-height: 1;
  }

  .signature-collections--{{ section.id }} .signature-collections__card-eyebrow {
    margin: 0 0 1rem;
    color: rgba(248, 239, 225, 0.82);
    font-size: 0.96rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .signature-collections--{{ section.id }} h3 {
    margin: 0 0 1.4rem;
    color: #f8efe1;
    font-size: clamp(3.2rem, 4vw, 4.8rem);
    line-height: 0.96;
    text-transform: uppercase;
  }

  .signature-collections--{{ section.id }} .signature-collections__link {
    color: var(--luxury-gold-soft);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .signature-collections--{{ section.id }} .signature-collections__grid {
      grid-template-columns: 1fr;
    }

    .signature-collections--{{ section.id }} .signature-collections__card:nth-child(even) {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .signature-collections--{{ section.id }} {
      padding: 5rem 0;
    }

    .signature-collections--{{ section.id }} .signature-collections__card {
      min-height: 52rem;
    }

    .signature-collections--{{ section.id }} .signature-collections__content {
      right: 1.4rem;
      bottom: 1.4rem;
      left: 1.4rem;
    }
  }
{%- endstyle -%}

<section class="signature-collections signature-collections--{{ section.id }}">
  <div class="page-width signature-collections__shell">
    <div class="signature-collections__intro scroll-trigger animate--fade-in">
      <p class="signature-collections__eyebrow">{{ collections_eyebrow }}</p>
      <h2>{{ collections_heading }}</h2>
      <p class="signature-collections__intro-copy">{{ collections_text }}</p>
    </div>

    <div class="signature-collections__grid">
      {% for block in section.blocks %}
        {%- assign fallback_img = block.settings.fallback_asset_name | append: '.jpg' -%}
        {%- assign collection_title = block.settings.title | default: block.settings.collection.title | default: 'Signature Collection' -%}
        {%- assign collection_eyebrow = block.settings.eyebrow | default: 'Signature Collection' -%}
        {%- assign collection_link = block.settings.collection.url | default: '/collections/all' -%}
        <article class="signature-collections__card scroll-trigger animate--slide-in" {{ block.shopify_attributes }}>
          <a href="{{ collection_link }}">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  alt: collection_title,
                  loading: 'lazy',
                  widths: '750, 1000, 1400, 1600',
                  sizes: '(min-width: 990px) 50vw, 100vw'
              }}
            {% elsif block.settings.fallback_asset_name != blank %}
              <img src="{{ fallback_img | asset_url }}" alt="{{ collection_title | escape }}" loading="lazy">
            {% endif %}
            <div class="signature-collections__overlay"></div>
            <div class="signature-collections__content">
              <span class="signature-collections__count">{{ forloop.index | prepend: '0' }}</span>
              <p class="signature-collections__card-eyebrow">{{ collection_eyebrow }}</p>
              <h3>{{ collection_title }}</h3>
              <span class="signature-collections__link">Discover the edit</span>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Signature Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signature Worlds"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "An editorial edit of bridal, festive, and modern occasion wear designed for ceremony and afterglow alike."
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Collection Title",
          "default": "Bridal Couture"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Signature Collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "fallback_asset_name",
          "label": "Default Asset Name (no extension)",
          "default": "beige_model_1"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Signature Collections"
    }
  ]
}
{% endschema %}
