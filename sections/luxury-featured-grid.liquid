{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .luxury-grid__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .luxury-grid__title {
    font-family: var(--font-luxury-heading);
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    margin: 0;
    letter-spacing: 0.1em;
    color: var(--luxury-ink);
  }

  .luxury-grid__subtitle {
    font-family: var(--font-luxury-body);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--luxury-gold);
    margin-top: 1rem;
    display: block;
  }

  .luxury-product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .luxury-product-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: 3rem;
    }
  }

  .luxury-product-card {
    text-align: center;
    position: relative;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .luxury-product-card:hover {
    transform: translateY(-5px);
  }

  .luxury-product-card__image-wrapper {
    position: relative;
    overflow: hidden;
    margin-bottom: 1.5rem;
    aspect-ratio: 3/4;
    background: #f9f5ee;
  }

  .luxury-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .luxury-product-card:hover .luxury-product-card__image {
    transform: scale(1.05);
  }

  .luxury-product-card__info {
    padding: 0 1rem;
  }

  .luxury-product-card__title {
    font-family: var(--font-luxury-heading);
    font-size: 1.8rem;
    margin: 0.5rem 0;
    color: var(--luxury-ink);
    text-decoration: none;
  }

  .luxury-product-card__price {
    font-family: var(--font-luxury-body);
    font-size: 1.3rem;
    color: var(--luxury-gold-dark);
    letter-spacing: 0.05em;
  }

  .luxury-grid__view-all {
    margin-top: 5rem;
    text-align: center;
  }
{%- endstyle -%}

<div class="luxury-featured-grid section-{{ section.id }}-padding page-width">
  <div class="luxury-grid__header">
    {%- if section.settings.subtitle != blank -%}
      <span class="luxury-grid__subtitle">{{ section.settings.subtitle }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="luxury-grid__title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="luxury-product-grid">
    {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
      <div class="luxury-product-card luxury-animate-on-scroll">
        <a href="{{ product.url }}" class="luxury-product-card__image-wrapper">
          <img
            src="{{ product.featured_media | image_url: width: 800 }}"
            alt="{{ product.title | escape }}"
            class="luxury-product-card__image"
            loading="lazy"
            width="800"
            height="1067"
          >
        </a>
        <div class="luxury-product-card__info">
          <a href="{{ product.url }}" class="luxury-product-card__title">
            {{ product.title }}
          </a>
          <div class="luxury-product-card__price">
            {{ product.price | money }}
          </div>
        </div>
      </div>
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="luxury-product-card luxury-animate-on-scroll">
          <div class="luxury-product-card__image-wrapper">
            {{ 'product-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="luxury-product-card__info">
            <h3 class="luxury-product-card__title">Sample Product {{ i }}</h3>
            <div class="luxury-product-card__price">$199.00</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div class="luxury-grid__view-all">
      <a href="{{ section.settings.collection.url }}" class="button luxury-btn">
        {{ section.settings.view_all_label | default: 'View All' }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Luxury Featured Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "The Latest Treasures"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View all' button"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Explore More"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Luxury Featured Grid"
    }
  ]
}
{% endschema %}
