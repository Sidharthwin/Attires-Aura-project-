{%- style -%}
  .luxury-marquee-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_vertical }}px 0;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    display: flex;
    align-items: center;
    position: relative;
    border-top: 1px solid rgba(201, 168, 76, 0.15); /* Subtle gold top border */
    border-bottom: 1px solid rgba(201, 168, 76, 0.15);
  }

  .luxury-marquee-track {
    display: flex;
    white-space: nowrap;
    /* CSS animation for infinite scrolling */
    animation: luxuryMarqueeScroll {{ section.settings.animation_speed }}s linear infinite;
  }

  /* Pause on hover if the user wants to read it */
  .luxury-marquee-{{ section.id }}:hover .luxury-marquee-track {
    animation-play-state: paused;
  }

  .luxury-marquee-content {
    display: flex;
    align-items: center;
    padding-right: 2rem; /* Space between the repeating phrases */
    font-family: var(--font-luxury-heading) !important;
    font-size: {{ section.settings.font_size }}px;
    color: {{ section.settings.text_color }};
    letter-spacing: {{ section.settings.letter_spacing }}em;
    text-transform: uppercase;
  }

  /* The ornamental dot divider between repeated text */
  .marquee-divider {
    color: var(--gold);
    font-size: 0.6em;
    margin: 0 2rem;
    vertical-align: middle;
  }

  @keyframes luxuryMarqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Scroll by exactly one instance of the content block */
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .luxury-marquee-content {
      font-size: {{ section.settings.font_size_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="luxury-marquee-{{ section.id }}">
  <div class="luxury-marquee-track">
    {%- capture marquee_text -%}
      <div class="luxury-marquee-content">
        {{ section.settings.text }}
        <span class="marquee-divider">✦</span>
        {{ section.settings.text }}
        <span class="marquee-divider">✦</span>
        {{ section.settings.text }}
        <span class="marquee-divider">✦</span>
        {{ section.settings.text }}
        <span class="marquee-divider">✦</span>
      </div>
    {%- endcapture -%}

    {%- comment -%}
      Repeat the capture block twice so the animation can loop seamlessly seamlessly
      (When it hits 50% translation, it snaps back to 0 perfectly)
    {%- endcomment -%}
    {{ marquee_text }}
    {{ marquee_text }}
    {{ marquee_text }}
    {{ marquee_text }}
  </div>
</section>

{% schema %}
{
  "name": "Luxury Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "Meticulously Handcrafted For The Modern Maharani"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#C9A84C"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop Font Size",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile Font Size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter Spacing (em)",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "default": 0.2
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Scroll Speed",
      "info": "Lower number is faster.",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top Margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom Margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Luxury Marquee"
    }
  ]
}
{% endschema %}
