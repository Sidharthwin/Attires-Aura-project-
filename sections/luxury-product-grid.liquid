{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 4
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign heading = section.settings.heading | default: collection.title | default: 'New Arrivals'
  assign subheading = section.settings.subheading | default: 'An editorial edit of our latest hand-finished couture.'
-%}

{%- style -%}
  .luxury-grid--{{ section.id }} {
    padding: clamp(6rem, 8vw, 10rem) 0;
    {% if section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
  }

  .luxury-grid--{{ section.id }} .luxury-grid__header {
    margin-bottom: clamp(4rem, 6vw, 7rem);
    text-align: {{ section.settings.text_alignment }};
  }

  .luxury-grid--{{ section.id }} .luxury-grid__eyebrow {
    margin: 0 0 1rem;
    color: var(--luxury-gold-dark);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .luxury-grid--{{ section.id }} h2 {
    margin: 0;
    font-size: clamp(3.2rem, 4vw, 5.4rem);
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--luxury-ink);
  }

  .luxury-grid--{{ section.id }} .luxury-grid__subheading {
    max-width: 54rem;
    margin: 1.8rem {% if section.settings.text_alignment == 'center' %}auto{% else %}0{% endif %} 0;
    color: var(--luxury-ink-soft);
    font-size: 1.14rem;
    line-height: 1.8;
  }

  .luxury-grid--{{ section.id }} .grid {
    display: grid !important;
    grid-template-columns: repeat({{ columns_desktop }}, 1fr) !important;
    gap: clamp(2rem, 3vw, 4rem) 2rem !important;
  }

  @media screen and (max-width: 989px) {
    .luxury-grid--{{ section.id }} .grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media screen and (max-width: 749px) {
    .luxury-grid--{{ section.id }} .grid {
      grid-template-columns: repeat(1, 1fr) !important;
    }
    
    @media screen and (min-width: 480px) {
      .luxury-grid--{{ section.id }} .grid {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }
  }

  .luxury-grid--{{ section.id }} .view-all-wrapper {
    margin-top: clamp(4rem, 6vw, 8rem);
    text-align: center;
  }
{%- endstyle -%}

<section class="luxury-product-grid luxury-grid--{{ section.id }}">
  <div class="page-width">
    <div class="luxury-grid__header scroll-trigger animate--fade-in">
      {%- if section.settings.eyebrow != blank -%}
        <p class="luxury-grid__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ heading }}</h2>
      {%- if subheading != blank -%}
        <p class="luxury-grid__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>

    <ul class="grid product-grid list-unstyled">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          <li class="grid__item scroll-trigger animate--slide-in"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
          >
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              section_id: section.id,
              quick_add: 'standard'
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <li class="grid__item scroll-trigger animate--slide-in">
            {%- assign placeholder_image = 'product-apparel-' | append: forloop.rindex -%}
            {% render 'card-product',
              show_vendor: section.settings.show_vendor,
              media_aspect_ratio: section.settings.image_ratio,
              placeholder_image: placeholder_image
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all and collection.all_products_count > products_to_show -%}
      <div class="view-all-wrapper scroll-trigger animate--fade-in">
        <a href="{{ collection.url }}" class="button luxury-btn">Explore The Collection</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Luxury Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxe Edit"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "An editorial edit of our latest hand-finished couture."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left",
      "label": "Text Alignment"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Enable 'View all' button"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    }
  ],
  "presets": [
    {
      "name": "Luxury Product Grid"
    }
  ]
}
{% endschema %}
